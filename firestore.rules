rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Licenças ──────────────────────────────────────────────────────────────
    match /licenses/{licId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Licenças por e-mail (auto-ativação multi-dispositivo) ────────────────
    match /licencas_clientes/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if request.auth != null;
    }

    // ── Mapa de usuário → estabelecimento ────────────────────────────────────
    // Cada usuário lê/cria o próprio; dono pode atualizar membros
    match /user_map/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.uid == resource.data.estab_uid
      );
    }

    // ── Convites ─────────────────────────────────────────────────────────────
    // Qualquer autenticado lê (para resgatar); dono cria/revoga
    match /invites/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.estab_uid;
    }

    // ── Super Admin (leitura global) ────────────────────────────────────────
    // victordarkxd@gmail.com pode listar user_map de qualquer uid
    match /user_map/{uid} {
      allow read: if request.auth != null && request.auth.token.email == 'victordarkxd@gmail.com';
    }

    // ── Dados do estabelecimento ──────────────────────────────────────────────
    // Dono tem acesso direto; membros via user_map; super admin lê tudo
    match /estabelecimentos/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.email == 'victordarkxd@gmail.com' ||
        (exists(/databases/$(database)/documents/user_map/$(request.auth.uid))
         && get(/databases/$(database)/documents/user_map/$(request.auth.uid)).data.estab_uid == uid)
      );
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        (exists(/databases/$(database)/documents/user_map/$(request.auth.uid))
         && get(/databases/$(database)/documents/user_map/$(request.auth.uid)).data.estab_uid == uid)
      );

      match /dados/{doc} {
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.token.email == 'victordarkxd@gmail.com' ||
          (exists(/databases/$(database)/documents/user_map/$(request.auth.uid))
           && get(/databases/$(database)/documents/user_map/$(request.auth.uid)).data.estab_uid == uid)
        );
        allow write: if request.auth != null && (
          request.auth.uid == uid ||
          (exists(/databases/$(database)/documents/user_map/$(request.auth.uid))
           && get(/databases/$(database)/documents/user_map/$(request.auth.uid)).data.estab_uid == uid)
        );
      }

      // Sessoes do WhatsApp — acesso via user_map (bot)
      match /whatsapp_sessions/{phone} {
        allow read, write: if request.auth != null && (
          request.auth.uid == uid ||
          (exists(/databases/$(database)/documents/user_map/$(request.auth.uid))
           && get(/databases/$(database)/documents/user_map/$(request.auth.uid)).data.estab_uid == uid)
        );
      }

      match /membros/{memberId} {
        allow read: if request.auth != null && (
          request.auth.uid == uid || request.auth.uid == memberId
        );
        // Dono pode tudo; membro pode criar seu próprio doc (ao aceitar convite)
        allow create: if request.auth != null && (
          request.auth.uid == uid || request.auth.uid == memberId
        );
        allow update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}

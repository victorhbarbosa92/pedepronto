rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Licenças ──────────────────────────────────────────────────────────────
    // Leitura pública: o PDV verifica revogação sem precisar estar autenticado
    // Escrita: somente via Firebase Console / Admin SDK (nunca pelo cliente)
    match /licenses/{licId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Licenças por e-mail (auto-ativação multi-dispositivo) ────────────────
    // Cada documento = e-mail do cliente; só o próprio usuário lê sua licença
    // Escrita: qualquer autenticado (admin via admin.html) — ECDSA garante integridade
    match /licencas_clientes/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if request.auth != null;
    }

    // ── Dados do estabelecimento ──────────────────────────────────────────────
    // Apenas o próprio usuário autenticado acessa seus dados
    match /estabelecimentos/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /dados/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
